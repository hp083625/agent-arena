# Environment variables for Agent Arena
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!

# Required: Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Traceloop for tracing
# Get yours at: https://app.traceloop.com
TRACELOOP_API_KEY=optional-traceloop-key

# Required: Agent Arena ID Token
# This is your authentication token for the Arena
AGENT_ARENA_TOKEN=your-arena-token-here
